# Build only from prepare_daily_context.py output; never use the API checkout context.
ARG BASE_IMAGE=timemap-source-test:d2fe00e2f48c-99a893d01fbc
FROM ${BASE_IMAGE}
USER root
COPY --chown=10001:10001 context-manifest.json /app/daily-context-manifest.json
COPY --chown=10001:10001 backend/ /app/backend/
COPY --chown=10001:10001 config/ /app/config/
COPY --chown=10001:10001 *.py /app/
RUN mkdir -p /app/data /app/web/data \
    && chown 10001:10001 /app/data /app/web /app/web/data
USER 10001:10001
CMD ["python", "-c", "print('DAILY_ENVIRONMENT_ONLY_NO_REPORT_EXECUTED')"]
